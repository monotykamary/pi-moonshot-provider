{
  "name": "pi-moonshot-provider",
  "version": "1.0.16",
  "description": "Moonshot AI provider extension for pi - Access Kimi K2.6, K2.5, K2 Thinking, and Moonshot V1 models through the Moonshot API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && node scripts/test-pi-compat.mjs",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "moonshot",
    "moonshot-ai",
    "ai",
    "llm",
    "kimi",
    "kimi-k2.6"
  ],
  "author": "",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.0",
    "typescript": "6.0.3",
    "@types/node": "^25.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
